# Copy to .env and fill in every value before running docker compose up -d
#   cp .env.example .env

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_USER=vpsguard
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=vpsguard
# Set to false and use migrations once you are running in production
POSTGRES_SYNCHRONIZE=true

# ------------------------------------------------------------------ InfluxDB
INFLUX_USER=vpsguard
INFLUX_PASSWORD=change_me_influx
INFLUX_ORG=vpsguard
INFLUX_BUCKET=metrics
# Metrics retention - the spec requires at least 30 days
INFLUX_RETENTION=30d
# Generate with: openssl rand -hex 32
INFLUX_TOKEN=change_me_influx_token

# --------------------------------------------------------------------- Redis
REDIS_PASSWORD=

# ----------------------------------------------------------------------- JWT
# Generate each with: openssl rand -hex 48
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

# ------------------------------------------------------- Bootstrap admin user
ADMIN_EMAIL=admin@vpsguard.local
ADMIN_PASSWORD=ChangeMe123!

# ---------------------------------------------------------- Public endpoints
# Permanent same-host Ubuntu example (see docs/quick-vps-setup.md):
#   PUBLIC_API_URL=http://213.5.196.34:4000
#   PUBLIC_WS_URL=http://213.5.196.34:4000
#   CORS_ORIGINS=http://213.5.196.34:3010
#   DASHBOARD_PORT=3010
SERVER_PORT=4000
DASHBOARD_PORT=3010
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WS_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3010

# ------------------------------------------------------------------- Agents
# An agent is considered offline after this many seconds without a heartbeat
AGENT_OFFLINE_AFTER_SECONDS=120

# ------------------------------------------------------------ Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=vpsguard@example.com
